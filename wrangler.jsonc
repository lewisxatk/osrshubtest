{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osrshubtest",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OSRSHUB_ENVIRONMENT": "test",
    "PUBLIC_ORIGIN": ""
  }
}
